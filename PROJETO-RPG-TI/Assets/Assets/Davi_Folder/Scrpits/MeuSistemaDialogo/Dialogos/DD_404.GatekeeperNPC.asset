  m_Script: {fileID: 11500000, guid: 19294077028485b4d90b4aed02e69fac, type: 3}
  m_Name: DD_404.GatekeeperNPC
  m_EditorClassIdentifier: 
  dialogueSentences:
  - dialoguerName: 404.Gatekeeper
    sentence: ACESSO NEGADO.
  - dialoguerName: Bernardo
    sentence: Eu preciso entrar.
  - dialoguerName: 404.Gatekeeper
    sentence: "IDENTIDADE INV\xC1LIDA. JOGADOR FORA DO ARQUIVO ORIGINAL."
  - dialoguerName: Bernardo
    sentence: Meu pai jogou esse lugar antes. Ele chegou aqui.
  - dialoguerName: 404.Gatekeeper
    sentence: "REGISTROS DETECTADOS\u2026 \u201CUSU\xC1RIO: ARTHUR\u201D."
  - dialoguerName: Bernardo
    sentence: Sim! Ele.
  - dialoguerName: 404.Gatekeeper
    sentence: "PROCESSO INTERROMPIDO. ARTHUR N\xC3O COMPLETOU CICLO. PROGRESSO CORROMPIDO."
  - dialoguerName: Bernardo
    sentence: "Ent\xE3o eu termino."
  - dialoguerName: 404.Gatekeeper
    sentence: "N\xC3O AUTORIZADO. TESTE DE VALIDA\xC7\xC3O NECESS\xC1RIO."
  - dialoguerName: Bernardo
    sentence: E o que isso significa?
  - dialoguerName: 404.Gatekeeper
    sentence: CONFRONTO.
  - dialoguerName: Bernardo
    sentence: Claro. Eu devia imaginar.
  - dialoguerName: 404.Gatekeeper
    sentence: "INICIANDO TESTE. SOBREVIVA\u2026 E O ACESSO SER\xC1 GARANTIDO."
